{
  "name": "jupyterlab-mdx",
  "version": "0.1.0",
  "description": "Markdown extensions with support for cross-references",
  "author": "David A. G. Harrison <dosirrah@gmail.com>",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/dosirrah/jupyterlab-mdx",
  "repository": {
    "type": "git",
    "url": "https://github.com/dosirrah/jupyterlab-mdx.git"
  },
  "bugs": {
    "url": "https://github.com/dosirrah/jupyterlab-mdx/issues"
  },
  "scripts": {
    "build:lib": "tsc --sourceMap",
    "build:labextension": "jupyter labextension build .",
    "build": "npm run build:lib && npm run build:labextension",
    "watch": "tsc -w --sourceMap & jupyter labextension watch .",
    "lint": "eslint src/**/*.ts",
    "test": "jest --coverage",
    "test:unit": "jest --coverage src/__tests__/syntax.spec.ts src/__tests__/sections.spec.ts src/__tests__/transform.spec.ts",
    "test:unit:watch": "jest --watch src/__tests__/syntax.spec.ts src/__tests__/sections.spec.ts src/__tests__/transform.spec.ts",
    "lab:build": "docker compose build",
    "lab:start": "docker compose up -d",
    "lab:stop": "docker compose down",
    "lab:build:dev": "docker compose -f docker-compose.dev.yml build",
    "lab:start:dev": "docker compose -f docker-compose.dev.yml up -d",
    "lab:stop:dev": "docker compose -f docker-compose.dev.yml down",
    "test:ui": "npx playwright test",
    "test:smoke": "npx playwright test playwright-tests/smoke.spec.ts playwright-tests/mdx_smoke.spec.ts"
  },
  "files": [
    "lib/**/*"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "dependencies": {
    "@jupyterlab/application": "^4.0.0",
    "@jupyterlab/cells": "^4.0.0",
    "@jupyterlab/notebook": "^4.0.0",
    "@jupyterlab/rendermime": "^4.0.0",
    "bibtex-parse-js": "^0.0.24"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.0.0",
    "@jupyterlab/testutils": "^4.0.0",
    "@playwright/test": "^1.58.2",
    "@types/jest": "^29.x",
    "@types/json-schema": "^7.0.11",
    "jest": "^29.x",
    "ts-jest": "^29.x",
    "typescript": "~5.8.3"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "jupyterlab_mdx/labextension/jupyterlab-mdx"
  },
  "packageManager": "yarn@4.9.1"
}
